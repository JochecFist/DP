\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces Srovnání tří přístupů k tréninku agentů: \uv  {self-play} (SP), kde agent hraje sám proti sobě; \uv  {population-play} (PP), kde interaguje s různými agenty v populaci; a \uv  {behavioral cloning play} (BCP), kde se učení zakládá na lidských demonstračních datech.}}{22}{figure.1.5}\protected@file@percent }
\newlabel{obrSPvsPPvsBCP}{{1.5}{22}{Srovnání tří přístupů k tréninku agentů: \uv {self-play} (SP), kde agent hraje sám proti sobě; \uv {population-play} (PP), kde interaguje s různými agenty v populaci; a \uv {behavioral cloning play} (BCP), kde se učení zakládá na lidských demonstračních datech}{figure.1.5}{}}
