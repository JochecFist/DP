\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Srovnání tří přístupů k~tréninku agentů: \uv  {self-play} (SP), kde agent hraje sám proti sobě; \uv  {population-play} (PP), kde interaguje s~různými agenty v~populaci; a \uv  {behavioral cloning play} (BCP), kde se učení zakládá na lidských demonstračních datech. Upraveno podle zdroje\cite  {Strouse2021}}}{18}{figure.1.3}\protected@file@percent }
\newlabel{obrSPvsPPvsBCP}{{1.3}{18}{Srovnání tří přístupů k~tréninku agentů: \uv {self-play} (SP), kde agent hraje sám proti sobě; \uv {population-play} (PP), kde interaguje s~různými agenty v~populaci; a \uv {behavioral cloning play} (BCP), kde se učení zakládá na lidských demonstračních datech. Upraveno podle zdroje\cite {Strouse2021}}{figure.1.3}{}}
